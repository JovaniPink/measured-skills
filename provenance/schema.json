{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jovanipink.com/schemas/skill-provenance-v1.json",
  "title": "JovaniPink skill provenance catalog",
  "type": "object",
  "required": ["$schema", "catalog_version", "reviewed_on", "entries"],
  "properties": {
    "$schema": {"const": "./schema.json"},
    "catalog_version": {"const": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "skill",
          "disposition",
          "implementation_method",
          "source_url",
          "upstream_license",
          "pinned_revision",
          "reviewed_on",
          "reviewed_material",
          "local_changes",
          "security_review",
          "rereview_triggers",
          "revocation"
        ],
        "properties": {
          "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "disposition": {"enum": ["covered", "partial", "public_candidate", "private_overlay", "rejected"]},
          "implementation_method": {"enum": ["original", "clean-room", "adapted", "vendored", "reference-only", "not-applicable"]},
          "source_url": {"type": "string", "format": "uri"},
          "upstream_license": {"type": "string", "minLength": 1},
          "pinned_revision": {"type": "string", "minLength": 1},
          "reviewed_on": {"type": "string", "format": "date"},
          "reviewed_material": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "local_changes": {"type": "string", "minLength": 1},
          "security_review": {"type": "string", "minLength": 1},
          "rereview_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "revocation": {"type": "string", "minLength": 1},
          "owned_origin": {
            "type": "object",
            "required": ["revision", "entrypoint", "license", "entrypoint_sha256", "license_sha256"],
            "properties": {
              "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "entrypoint": {"type": "string", "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"},
              "license": {"const": "MIT"},
              "entrypoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "license_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
