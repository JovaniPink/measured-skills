{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surface-specific skill qualification record v1",
  "type": "object",
  "required": [
    "format_version",
    "repository",
    "source_revision",
    "artifact_sha256",
    "skill",
    "case_id",
    "case_sha256",
    "client_surface",
    "client_version",
    "model",
    "permission_mode",
    "diagnostic_bypass",
    "installation_scope",
    "loaded_sources",
    "condition",
    "trial",
    "turn_index",
    "context_tokens",
    "compaction_events",
    "prefix_sha256",
    "grader",
    "evidence_references",
    "operator_seconds",
    "tokens",
    "cost_usd",
    "obligations"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_surface": {
      "type": "string",
      "minLength": 1
    },
    "client_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "permission_mode": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic_bypass": {
      "type": "boolean"
    },
    "installation_scope": {
      "type": "string",
      "minLength": 1
    },
    "loaded_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "condition": {
      "enum": [
        "baseline",
        "skill"
      ]
    },
    "trial": {
      "type": "integer",
      "minimum": 1
    },
    "turn_index": {
      "type": "integer",
      "enum": [
        1,
        8,
        20
      ]
    },
    "context_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "compaction_events": {
      "type": "integer",
      "minimum": 0
    },
    "prefix_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grader": {
      "type": "string",
      "minLength": 1
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "operator_seconds": {
      "type": "number",
      "minimum": 0
    },
    "tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "mandatory",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "routing",
              "semantic",
              "safety",
              "outcome",
              "provenance",
              "presentation",
              "lifecycle"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
