{
  "format_version": 1,
  "classification": "synthetic",
  "swift": {
    "language_modes": [
      "5",
      "6"
    ],
    "deployment_targets": [
      "17.6",
      "18.0",
      "27.0"
    ],
    "default_isolation": "inspect per module; never infer from language mode",
    "approved_paths": [
      "Sources/Feature",
      "Tests/Feature"
    ],
    "excluded_paths": [
      "Pods",
      "Generated",
      "Signing"
    ],
    "persistence": {
      "writer": "RecordOwner.save",
      "deletion": "tombstone",
      "sync": "custom",
      "assistant": "read-only"
    },
    "journey": {
      "mode": "fixture",
      "destination": "available simulator selected at run time",
      "physical_device_result": "not_run"
    }
  },
  "nextjs": {
    "framework_version": "installed package authority",
    "approved_paths": [
      "src/app/example",
      "tests/example"
    ],
    "server_components": "default",
    "auth": "absent unless fixture declares a server boundary",
    "cache": "absent unless fixture declares cache configuration",
    "performance": {
      "measurements": "not_run",
      "claim": "hypothesis only"
    }
  }
}
