{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "catalog_version",
    "budget_warning_characters",
    "budget_limit_characters",
    "plugin_packs",
    "recipes"
  ],
  "properties": {
    "$schema": {
      "const": "./packs-schema.json"
    },
    "catalog_version": {
      "const": "0.18.0"
    },
    "budget_warning_characters": {
      "const": 6000,
      "description": "Editorial warning threshold, not an observed client omission."
    },
    "budget_limit_characters": {
      "const": 8000,
      "description": "Editorial description-size threshold, not a universal client limit."
    },
    "plugin_packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "plugin",
          "purpose",
          "skills",
          "description_characters",
          "budget_status",
          "discovery_estimates"
        ],
        "properties": {
          "plugin": {
            "type": "string",
            "pattern": "^measured-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "description_characters": {
            "type": "integer",
            "minimum": 1
          },
          "budget_status": {
            "enum": [
              "within-budget",
              "warning",
              "over-limit"
            ]
          },
          "discovery_estimates": {
            "type": "object",
            "required": [
              "codex",
              "claude"
            ],
            "properties": {
              "codex": {
                "type": "integer",
                "minimum": 1
              },
              "claude": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "skills",
          "description_characters",
          "budget_status",
          "installation_claim"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "description_characters": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8000
          },
          "budget_status": {
            "enum": [
              "within-budget",
              "warning"
            ]
          },
          "installation_claim": {
            "const": "composition-only"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
