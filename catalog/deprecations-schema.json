{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "catalog_version",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "./deprecations-schema.json"
    },
    "catalog_version": {
      "const": "0.18.0"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "replacement",
          "announcement_version",
          "removal_version",
          "migration_steps",
          "reason"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "replacement": {
            "type": "string",
            "minLength": 1
          },
          "announcement_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "removal_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "migration_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
