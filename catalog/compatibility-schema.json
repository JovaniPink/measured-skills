{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "catalog_version",
    "records"
  ],
  "properties": {
    "$schema": {
      "const": "./compatibility-schema.json"
    },
    "catalog_version": {
      "const": "0.18.0"
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "plugin_version",
          "evidence_path",
          "acceptance_status",
          "claim"
        ],
        "properties": {
          "plugin_version": {
            "type": "string",
            "pattern": "^0\\.(?:[1-9]|[1-9][0-9]+)\\.[0-9]+$"
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_status": {
            "enum": [
              "accepted",
              "blocked"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
