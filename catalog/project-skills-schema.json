{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned project skill selection v1",
  "type": "object",
  "required": ["format_version", "source_commit", "prefix", "contract", "skills", "codex_version"],
  "properties": {
    "format_version": {"const": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prefix": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "contract": {"type": "string", "pattern": "^docs/skills/[a-zA-Z0-9_-]+\\.md$"},
    "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "codex_version": {"const": "0.154.0"}
  },
  "additionalProperties": false
}
