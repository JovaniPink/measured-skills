{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "catalog_version",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "./revocations-schema.json"
    },
    "catalog_version": {
      "const": "0.17.1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "revoked_on",
          "reason",
          "replacement",
          "security_immediate"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "revoked_on": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "replacement": {
            "type": "string",
            "minLength": 1
          },
          "security_immediate": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
