{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "catalog_version",
    "reviewed_on",
    "max_review_age_days",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "./upstream-pins-schema.json"
    },
    "catalog_version": {
      "const": "0.18.0"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "max_review_age_days": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_url",
          "marker_kind",
          "marker_value"
        ],
        "properties": {
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "marker_kind": {
            "enum": [
              "etag",
              "last-modified",
              "content-sha256",
              "normalized-content-sha256"
            ]
          },
          "marker_value": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
